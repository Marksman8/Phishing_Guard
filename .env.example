# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which LLM backend to use: gemini | ollama | echo
PHISHGUARD_PROVIDER=gemini

# --- Google AI Studio (free tier) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Seconds before an LLM call is abandoned (lowers confidence, never invents a result)
LLM_TIMEOUT=30
